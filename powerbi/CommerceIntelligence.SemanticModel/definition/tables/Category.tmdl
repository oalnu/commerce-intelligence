table Category
	lineageTag: 6dceb298-a2a3-5c2f-a64b-f997deab3e74

	column 'Category Key'
		dataType: string
		isHidden
		lineageTag: a9ff8f80-14cb-5755-b4af-49d0f7cb377b
		summarizeBy: none
		sourceColumn: category_key

	column Category
		dataType: string
		lineageTag: 0ce1138f-9323-5be8-be77-e5c1f36b085f
		summarizeBy: none
		sourceColumn: category

	partition Category = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "/dim_category.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"category_key", type text}, {"category", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

