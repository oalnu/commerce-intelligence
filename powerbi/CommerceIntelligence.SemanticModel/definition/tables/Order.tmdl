	partition Order = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "/fact_order.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"order_id", type text}, {"customer_id", type text}, {"order_status", type text}, {"purchased_at", type datetime}, {"approved_at", type datetime}, {"carrier_at", type datetime}, {"delivered_at", type datetime}, {"estimated_at", type datetime}, {"customer_unique_id", type text}, {"customer_state", type text}, {"date_key", Int64.Type}, {"purchase_date", type date}, {"core_period", Int64.Type}, {"item_count", Int64.Type}, {"seller_count", Int64.Type}, {"category_count", Int64.Type}, {"seller_key", type text}, {"category_key", type text}, {"merchandise_brl", Currency.Type}, {"freight_brl", Currency.Type}, {"payment_brl", Currency.Type}, {"payment_count", Int64.Type}, {"review_count", Int64.Type}, {"review_score", Int64.Type}, {"review_answered_at", type datetime}, {"delivery_eligible", Int64.Type}, {"post_delivery_review", Int64.Type}, {"is_late", Int64.Type}, {"delivery_days", type number}, {"late_days", Int64.Type}, {"approval_days", type number}, {"handoff_days", type number}, {"transit_days", type number}, {"delay_band", type text}, {"delay_band_sort", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

